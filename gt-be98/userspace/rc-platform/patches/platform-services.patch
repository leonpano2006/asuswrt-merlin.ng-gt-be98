+static int leon_dispatch_daemon(const char *script, int action)
+{
+#if !defined(RTCONFIG_RSYSLOGD)
+	if (!strcmp(script, "leon_syslogd")) {
+		if (action & RC_SERVICE_STOP) stop_syslogd();
+		if (action & RC_SERVICE_START) start_syslogd();
+		return 1;
+	}
+#endif
+#if !defined(RTCONFIG_RSYSLOGD)
+	if (!strcmp(script, "leon_klogd")) {
+		if (action & RC_SERVICE_STOP) stop_klogd();
+		if (action & RC_SERVICE_START) start_klogd();
+		return 1;
+	}
+#endif
+#if defined(CONFIG_BCMWL5)
+	if (!strcmp(script, "leon_eapd")) {
+		if (action & RC_SERVICE_STOP) stop_eapd();
+		if (action & RC_SERVICE_START) start_eapd();
+		return 1;
+	}
+#endif
+#if defined(CONFIG_BCMWL5)
+	if (!strcmp(script, "leon_acsd")) {
+		if (action & RC_SERVICE_STOP) stop_acsd();
+		if (action & RC_SERVICE_START) start_acsd();
+		return 1;
+	}
+#endif
+#if defined(BCM_BSD)
+	if (!strcmp(script, "leon_bsd")) {
+		if (action & RC_SERVICE_STOP) stop_bsd();
+		if (action & RC_SERVICE_START) start_bsd();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_WLCEVENTD)
+	if (!strcmp(script, "leon_wlceventd")) {
+		if (action & RC_SERVICE_STOP) stop_wlceventd();
+		if (action & RC_SERVICE_START) start_wlceventd();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_NEW_USER_LOW_RSSI)
+	if (!strcmp(script, "leon_roamast")) {
+		if (action & RC_SERVICE_STOP) stop_roamast();
+		if (action & RC_SERVICE_START) start_roamast();
+		return 1;
+	}
+#endif
+#if defined(LINUX26)
+	if (!strcmp(script, "leon_hotplug2")) {
+		if (action & RC_SERVICE_STOP) stop_hotplug2();
+		if (action & RC_SERVICE_START) start_hotplug2();
+		return 1;
+	}
+#endif
+	if (!strcmp(script, "leon_networkmap")) {
+		if (action & RC_SERVICE_STOP) stop_networkmap();
+		if (action & RC_SERVICE_START) start_networkmap(0);
+		return 1;
+	}
+#if defined(RTCONFIG_NOTIFICATION_CENTER)
+	if (!strcmp(script, "leon_notification")) {
+		if (action & RC_SERVICE_STOP) stop_notification_center();
+		if (action & RC_SERVICE_START) start_notification_center();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_PROTECTION_SERVER)
+	if (!strcmp(script, "leon_protection")) {
+		if (action & RC_SERVICE_STOP) stop_ptcsrv();
+		if (action & RC_SERVICE_START) start_ptcsrv();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_NETOOL)
+	if (!strcmp(script, "leon_netool")) {
+		if (action & RC_SERVICE_STOP) stop_netool();
+		if (action & RC_SERVICE_START) start_netool();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_CFGSYNC)
+	if (!strcmp(script, "leon_cfgsync")) {
+		if (action & RC_SERVICE_STOP) stop_cfgsync();
+		if (action & RC_SERVICE_START) start_cfgsync();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_SAMBASRV)
+	if (!strcmp(script, "leon_wsdd")) {
+		if (action & RC_SERVICE_STOP) stop_wsdd();
+		if (action & RC_SERVICE_START) start_wsdd();
+		return 1;
+	}
+#endif
+#if defined(RTCONFIG_HTTPS) && defined(RTCONFIG_IPV6)
+	if (!strcmp(script, "leon_httpd6")) {
+		if (action & RC_SERVICE_STOP) leon_rc_daemon_status("httpds6", 0, NULL);
+		if (action & RC_SERVICE_START) start_httpd_ipv6();
+		return 1;
+	}
+#endif
+	return 0;
+}
