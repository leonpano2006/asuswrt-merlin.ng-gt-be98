+static int ipsec_copy_ifname(char *dst, const char *src)
+{
+	size_t len = src ? strnlen(src, IFNAMSIZ) : IFNAMSIZ;
+
+	dst[0] = '\0';
+	if (len == IFNAMSIZ)
+		return -1;
+	memcpy(dst, src, len + 1);
+	return 0;
+}
