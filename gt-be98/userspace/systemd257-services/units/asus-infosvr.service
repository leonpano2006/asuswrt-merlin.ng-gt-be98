[Unit]
Description=ASUS LAN device discovery
DefaultDependencies=no
RequiresMountsFor=/run /var
After=systemd-journald.service
PartOf=asus-rc.service
Conflicts=shutdown.target
Before=shutdown.target
JobTimeoutSec=20
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStartPre=/usr/libexec/leon-service-owner-check infosvr
ExecStart=/usr/sbin/infosvr br0
Restart=always
RestartSec=2
TimeoutStartSec=10
TimeoutStopSec=10
KillMode=control-group
TasksMax=infinity
TasksAccounting=no
MemoryAccounting=no
StandardOutput=journal
StandardError=journal
