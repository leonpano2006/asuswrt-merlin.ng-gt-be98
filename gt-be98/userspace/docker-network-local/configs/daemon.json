{
  "data-root": "/jffs/docker/data",
  "exec-root": "/var/run/leon-docker",
  "pidfile": "/var/run/leon-docker/dockerd.pid",
  "hosts": [
    "unix:///var/run/docker.sock"
  ],
  "group": "root",
  "exec-opts": [
    "native.cgroupdriver=cgroupfs"
  ],
  "storage-driver": "overlay2",
  "features": {
    "containerd-snapshotter": false
  },
  "iptables": true,
  "ip6tables": false,
  "ip-forward": true,
  "ip-masq": true,
  "userland-proxy": true,
  "max-concurrent-downloads": 1,
  "max-concurrent-uploads": 1,
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "2"
  },
  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Soft": 65536,
      "Hard": 65536
    }
  },
  "bip": "172.30.98.1/24",
  "default-address-pools": [
    {
      "base": "172.31.0.0/16",
      "size": 24
    }
  ],
  "ip-forward-no-drop": true,
  "icc": true,
  "ipv6": false,
  "userland-proxy-path": "/usr/local/bin/docker-proxy",
  "live-restore": true
}
